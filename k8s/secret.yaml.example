# The real Secret is NOT stored in git. It is created from your git-ignored .env file:
#
#   kubectl -n vigilops create secret generic vigilops-secrets --from-env-file=.env
#
# Each line of .env becomes one key. The services expect these keys:
#   RABBITMQ_USER, RABBITMQ_PASS, POSTGRES_USER, POSTGRES_PASSWORD,
#   NOTIFIER, SMTP_USER, SMTP_PASSWORD, MAIL_TO
#
# This file only documents the shape. Never put real values in it.
apiVersion: v1
kind: Secret
metadata:
  name: vigilops-secrets
  namespace: vigilops
type: Opaque
stringData:
  RABBITMQ_USER: changeme
  RABBITMQ_PASS: changeme
  POSTGRES_USER: changeme
  POSTGRES_PASSWORD: changeme
  NOTIFIER: console
  SMTP_USER: you@gmail.com
  SMTP_PASSWORD: changeme
  MAIL_TO: you@gmail.com
