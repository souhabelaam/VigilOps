# Copy this file to .env and choose your own values. .env is git-ignored.
RABBITMQ_USER=changeme
RABBITMQ_PASS=changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Email alerts (optional). Leave NOTIFIER=console to only print alerts in the log.
# For Gmail: turn on 2-step verification, then create an "app password" and put it here.
NOTIFIER=console
SMTP_USER=you@gmail.com
SMTP_PASSWORD=changeme
MAIL_TO=you@gmail.com
